# ── Which database? ───────────────────────────────────────────────
# libsql = SQLite file (local development).  mysql = Hostinger MySQL.
DB_DIALECT=libsql

# libSQL / SQLite (DB_DIALECT=libsql)
CMS_LIBSQL_URL=file:./data/media1313.db

# MySQL (DB_DIALECT=mysql) — from hPanel → Databases → MySQL Databases
# CMS_MYSQL_HOST=localhost
# CMS_MYSQL_PORT=3306
# CMS_MYSQL_DATABASE=u123456789_media1313
# CMS_MYSQL_USER=u123456789_media
# CMS_MYSQL_PASSWORD=change-me

# ── Secrets ───────────────────────────────────────────────────────
# StudioCMS auth encryption key AND member-login token signing key:  openssl rand -base64 16
CMS_ENCRYPTION_KEY=
# Lets you PUT /api/content/:key to edit shows/schedule/etc. Leave empty to disable.  openssl rand -hex 24
ADMIN_TOKEN=

# ── Networking ────────────────────────────────────────────────────
# Comma-separated site origins allowed to call /api (or * for any)
CORS_ORIGIN=*

# Set to false after you finish the /start setup wizard and create the owner account
CMS_FIRST_RUN=true
