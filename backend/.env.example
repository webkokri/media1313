# ── Database ──────────────────────────────────────────────────────
# libsql = SQLite file (local development).  mysql = MySQL/MariaDB (Hostinger).
DB_DIALECT=libsql
CMS_LIBSQL_URL=file:./data/media1313.db
# DB_DIALECT=mysql
# CMS_MYSQL_HOST=localhost
# CMS_MYSQL_PORT=3306
# CMS_MYSQL_DATABASE=
# CMS_MYSQL_USER=
# CMS_MYSQL_PASSWORD=

# ── Secrets / paths ───────────────────────────────────────────────
# Signs login cookies and member tokens.   openssl rand -base64 32
APP_SECRET=
# Where uploaded images are stored (keep outside the web root and outside git)
UPLOAD_DIR=./uploads
# Folder with the built React site (Vite `dist`) for the SPA fallback
WEB_ROOT=../dist
PORT=4321

# ── AI blog (optional) ────────────────────────────────────────────
# The Anthropic API key can be pasted in the admin (AI blog page) instead. If set here it takes priority.
# ANTHROPIC_API_KEY=sk-ant-...
# Lets a real cron job trigger the scheduler:  curl "https://YOUR-SITE/api/cron/autoblog?key=$CRON_KEY"   (disabled when empty)
CRON_KEY=
